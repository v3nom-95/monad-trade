# Google Gemini API key, used server-side only by app/api/ai/route.ts.
# NEVER prefix this with NEXT_PUBLIC_ — that would ship the key to the browser.
#
# Local:  copy this file to .env.local and fill in the value.
# Vercel: Settings -> Environment Variables -> add GOOGLE_API_KEY, then redeploy.
GOOGLE_API_KEY=
